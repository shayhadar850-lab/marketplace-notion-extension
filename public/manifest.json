{
  "manifest_version": 3,
  "name": "Notion Marketplace Draft Assistant",
  "version": "0.1.0",
  "description": "Imports 3D print products from Notion, checks listing risk, and fills Facebook Marketplace drafts with manual publishing.",
  "action": {
    "default_title": "Open Marketplace Queue"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["storage", "sidePanel", "activeTab", "scripting"],
  "host_permissions": ["https://api.notion.com/*", "https://www.facebook.com/marketplace/*", "https://*/*", "http://*/*"],
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/marketplace/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
